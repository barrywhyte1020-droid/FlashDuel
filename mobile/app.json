{
  "expo": {
    "name": "FlashDuel",
    "slug": "flashduel",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./src/assets/icon.png",
    "splash": {
      "backgroundColor": "#14162B"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14162B"
      }
    },
    "web": { "bundler": "metro" }
  }
}
